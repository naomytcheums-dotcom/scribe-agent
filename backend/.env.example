DATABASE_URL=sqlite:///./scribe_agent.db

# Empty LLM_BASE_URL = OpenAI. For a free OpenAI-compatible provider:
# Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai/  (model: gemini-flash-latest)
# Groq          : https://api.groq.com/openai/v1                            (model: llama-3.3-70b-versatile)
# Note: audio transcription needs a provider that supports the Whisper-style
# /audio/transcriptions endpoint — OpenAI works out of the box; Groq also
# offers a free Whisper model if you'd rather avoid OpenAI entirely.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
TRANSCRIPTION_MODEL=whisper-1

CORS_ORIGINS=["http://localhost:5173"]

# Optional: gate the whole app behind a single shared password in production.
SITE_PASSWORD=
